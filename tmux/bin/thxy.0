#!/usr/bin/env bash

set -euo pipefail

script_path="$0"
hxyz_home="${HXYZ_HOME:-$HOME/.config/hxyz}"

# Uncomment to enable debug logging: tail -f /tmp/hxyz.log
# exec 2>>/tmp/hxyz.log; set -x

usage() {
  cat <<'EOF'
Usage: hxyz [-s <session-name>] <command> [args]

Options:
  -s <name>             Session name (default: hxyz-$pid).

Commands:
  picker [path]         Toggle a left-side Yazi pane in the current tmux window.
  git                   Open LazyGit in a centered floating tmux popup.
  vibe [file] [line]    Open Copilot CLI in a floating popup named 'vibe'.
  buffer <pane> <cwd>   Internal: launch Yazi inside the picker pane.
  buffer edit <pane> <path>...
                        Internal: open Yazi selections in Helix.
EOF
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

########################################## PICKER ##########################################

# Resolves the working directory from an optional path argument.
# If a file is given, returns its parent directory. Falls back to $PWD.
resolve_cwd() {
  local target="${1:-}"

  if [[ -z "$target" ]]; then
    pwd
    return
  fi

  if [[ -d "$target" ]]; then
    cd -- "$target" && pwd
    return
  fi

  if [[ -f "$target" ]]; then
    cd -- "$(dirname -- "$target")" && pwd
    return
  fi

  pwd
}

focus_pane_if_needed() {
  local pane_id="$1"
  local current_pane
  current_pane="$(tmux display-message -p '#{pane_id}')"
  if [[ "$current_pane" != "$pane_id" ]]; then
    tmux select-pane -t "$pane_id"
  fi
}

# Toggles a Yazi file-picker pane on the left side of the current tmux window.
# If a picker pane already exists it is closed. Otherwise a new picker pane is opened,
# placed on the left, and focused.
toggle_picker() {
  [[ -n "${TMUX:-}" ]] || fail "picker must be run inside tmux"
  [[ -n "${TMUX_PANE:-}" ]] || fail "TMUX_PANE is not set"

  local origin_pane="${TMUX_PANE}"
  local cwd
  cwd="$(resolve_cwd "${1:-}")"

  # Find the picker pane (@hxyz_role == "picker") in the current window
  local other_pane_id=""
  other_pane_id="$(tmux list-panes -F '#{pane_id} #{@hxyz_role}' | awk '$2 == "picker" {print $1; exit}')"

  if [[ -n "$other_pane_id" ]]; then
    # Close the existing picker pane
    tmux kill-pane -t "$other_pane_id"
    focus_pane_if_needed "$origin_pane"

    # Ensure origin pane has its role set/restored
    tmux set-option -p -t "$origin_pane" @hxyz_role "editor"
    return
  fi

  # Create new picker pane; the buffer subcommand launches Yazi inside it.
  # We split the window horizontally, to the left (-b), at 20% width.
  local picker_id
  picker_id="$(tmux split-window -P -F "#{pane_id}" -h -b -p 20 -c "$cwd" "$script_path" buffer "$origin_pane" "$cwd")"

  # Set the role option on the new pane
  tmux set-option -p -t "$picker_id" @hxyz_role "picker"

  # Also ensure the origin pane has the editor role option
  tmux set-option -p -t "$origin_pane" @hxyz_role "editor"

  focus_pane_if_needed "$picker_id"
}

########################################## BUFFER ##########################################

# Sends a command to a Helix instance running in the given pane.
# Presses Escape multiple times to ensure exit from edit/insert mode, then runs :<command><Enter>.
write_to_helix() {
  local pane_id="$1"
  shift
  local command_text="$*"

  focus_pane_if_needed "$pane_id"
  # Send Escape twice to ensure we exit edit mode and any insert mode
  tmux send-keys -t "$pane_id" Escape Escape
  tmux send-keys -t "$pane_id" -l ":$command_text"
  tmux send-keys -t "$pane_id" Enter
}

# Entry point for the picker pane process. Sets $EDITOR so that Yazi calls
# back into this script to open files in the origin Helix pane.
run_buffer() {
  local origin_pane="$1"
  local cwd="$2"

  export EDITOR="$script_path buffer edit $origin_pane"
  export TMUX_PANE_NAME="picker"

  if [[ "${HXYZ_USE_YAZI_CONFIG:-true}" != "false" ]]; then
    export YAZI_CONFIG_HOME="${hxyz_home}"
  fi

  cd -- "$cwd"
  exec yazi "$cwd"
}

# Called by Yazi (via $EDITOR) when the user opens a selection.
# Sends a Helix :open or :cd command to the origin pane, then exits.
edit_from_picker() {
  local origin_pane="$1"
  shift
  local paths=("$@")
  local escaped_paths=()
  local path

  [[ ${#paths[@]} -gt 0 ]] || exit 0

  for path in "${paths[@]}"; do
    escaped_paths+=("$(printf '%q' "$path")")
  done

  if [[ ${#escaped_paths[@]} -eq 1 && ! -f "${paths[0]}" ]]; then
    write_to_helix "$origin_pane" "cd ${escaped_paths[0]}"
    exit 0
  fi

  write_to_helix "$origin_pane" "open ${escaped_paths[*]}"
}

########################################## VIBE ##########################################

# Opens the Copilot CLI floating popup ('vibe'), creating it if needed.
# If the session already exists, pastes @file:line context into it.
open_vibe() {
  [[ -n "${TMUX:-}" ]] || fail "vibe must be run inside tmux"

  local file="${1:-}"
  local line="${2:-}"

  # Check if vibe session already exists
  if ! tmux has-session -t vibe 2>/dev/null; then
    # Create the background session with copilot
    tmux new-session -d -s vibe -n vibe copilot
    sleep 0.1
  fi

  if [[ -n "$file" && -n "$line" ]]; then
    tmux send-keys -t vibe:0.0 C-u "@${file}:${line} "
  fi

  # Open the popup and attach to the vibe session
  tmux display-popup -w 80% -h 80% -E "tmux attach-session -t vibe"
}

########################################## GIT ##########################################

# Opens LazyGit in a centered floating tmux popup.
open_lazygit() {
  [[ -n "${TMUX:-}" ]] || fail "git must be run inside tmux"

  tmux display-popup -w 90% -h 90% -d "#{pane_current_path}" -E "lazygit"
}

########################################## MAIN ##########################################

# Parses top-level flags (-s), dispatches to the appropriate sub-command, or
# bootstraps a new tmux session with Helix when called with no arguments.
main() {
  local session_name_arg=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s)
        shift
        [[ $# -gt 0 ]] || fail "-s requires a session name"
        session_name_arg="$1"
        shift
        ;;
      *)
        break
        ;;
    esac
  done

  local command="${1:-}"

  case "$command" in
    picker)
      shift
      toggle_picker "${1:-}"
      ;;
    git)
      shift
      open_lazygit
      ;;
    vibe)
      shift
      open_vibe "${1:-}" "${2:-}"
      ;;
    buffer)
      shift
      if [[ "${1:-}" == "edit" ]]; then
        shift
        [[ $# -ge 2 ]] || fail "buffer edit requires <origin-pane> <path>..."
        edit_from_picker "$@"
      else
        [[ $# -eq 2 ]] || fail "buffer requires <origin-pane> <cwd>"
        run_buffer "$1" "$2"
      fi
      ;;
    -h|--help|help)
      usage
      ;;
    "")
      # No command passed: start tmux with Helix if not already running
      if [[ -z "${TMUX:-}" ]]; then
        local session_name="${session_name_arg:-hxyz-$$}"
        local helix_cmd="hx"
        if ! command -v hx &> /dev/null && command -v helix &> /dev/null; then
          helix_cmd="helix"
        fi

        tmux new-session -d -s "$session_name" -n editor "$helix_cmd"
        tmux set-option -t "$session_name:0.0" -p @hxyz_role "editor"
        tmux attach-session -t "$session_name"
      else
        tmux set-option -p @hxyz_role "editor"

        # Try 'hx' first, then fall back to 'helix'
        if command -v hx &> /dev/null; then
          exec hx
        elif command -v helix &> /dev/null; then
          exec helix
        else
          fail "helix not found. Please install helix or hx"
        fi
      fi
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
