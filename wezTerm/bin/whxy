#!/usr/bin/env bash

set -euo pipefail

# Set MULTIPLEXER environment variable for this script
export MULTIPLEXER=wezterm

script_path="$0"
whxy_home="${WHXY_HOME:-$HOME/.config/whxy}"

# Uncomment to enable debug logging: tail -f /tmp/whxy.log
# exec 2>>/tmp/whxy.log; set -x

usage() {
  cat <<'EOF'
Usage: whxy <command> [args]

Commands:
  picker [path]         Toggle a left-side yazi pane in the current WezTerm tab.
  terminal              Toggle a terminal pane at the bottom of the current WezTerm tab.
  git                   Open LazyGit in a WezTerm pane.
  vibe [file] [line]    Open Copilot CLI in a WezTerm pane.
  buffer <pane> <cwd>   Internal: launch yazi inside the picker pane.
  buffer edit <pane> <path>...
                        Internal: open yazi selections in Helix.
EOF
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

########################################## WEZTERM HELPERS ##########################################

# Get the current pane ID from WezTerm
current_pane_id() {
  echo "${WEZTERM_PANE:-}"
}

# Get all panes in the current tab as JSON
get_panes_in_tab() {
  wezterm cli list --format=json 2>/dev/null | jq -c '.[]' || echo ""
}

# Find a pane with a specific title in the current tab
find_pane_by_title() {
  local target_title="$1"
  local current_tab_id
  local current_pane
  
  current_pane="$(current_pane_id)"
  [[ -n "$current_pane" ]] || return 1
  
  # Get the tab_id from the current pane
  current_tab_id="$(wezterm cli list --format=json 2>/dev/null | jq -r ".[] | select(.pane_id == $current_pane) | .tab_id" | head -n1)"
  [[ -n "$current_tab_id" ]] || return 1
  
  # Find pane with matching title in the same tab
  wezterm cli list --format=json 2>/dev/null | jq -r ".[] | select(.tab_id == $current_tab_id and .title == \"$target_title\") | .pane_id" | head -n1
}

# Focus a pane by its ID
focus_pane() {
  local pane_id="$1"
  wezterm cli activate-pane --pane-id "$pane_id" 2>/dev/null || true
}

# Kill a pane by its ID
kill_pane() {
  local pane_id="$1"
  wezterm cli kill-pane --pane-id "$pane_id" 2>/dev/null || true
}

########################################## PICKER ##########################################

# Resolves the working directory from an optional path argument.
# If a file is given, returns its parent directory. Falls back to $PWD.
resolve_cwd() {
  local target="${1:-}"

  if [[ -z "$target" ]]; then
    pwd
    return
  fi

  if [[ -d "$target" ]]; then
    cd -- "$target" && pwd
    return
  fi

  if [[ -f "$target" ]]; then
    cd -- "$(dirname -- "$target")" && pwd
    return
  fi

  pwd
}

# Toggles a Yazi file-picker pane on the left side of the current WezTerm tab.
# If a picker pane already exists it is closed.
# Otherwise a new picker pane is opened and resized.
toggle_picker() {
  [[ -n "${WEZTERM_PANE:-}" ]] || fail "picker must be run inside WezTerm"

  local origin_pane="${WEZTERM_PANE}"
  local cwd
  cwd="$(resolve_cwd "${1:-}")"

  # Find the picker pane (title == "whxy-side-panel") in this tab
  local picker_pane_id
  picker_pane_id="$(find_pane_by_title "whxy-side-panel")"

  if [[ -n "$picker_pane_id" ]]; then
    # Close the existing picker pane
    kill_pane "$picker_pane_id"
    focus_pane "$origin_pane"
    return
  fi

  # Create new picker pane; the buffer subcommand launches Yazi inside it
  local cmd
  printf -v cmd '%q buffer %q %q' "$script_path" "$origin_pane" "$cwd"
  
  # Split the pane horizontally (left side), 20% width
  local picker_id
  picker_id="$(wezterm cli split-pane --left --percent 20 --cwd "$cwd" -- bash -c "$cmd" 2>/dev/null | grep -o '[0-9]*' | head -n1)"

  if [[ -n "$picker_id" ]]; then
    # Set the pane title to "whxy-side-panel"
    wezterm cli set-tab-title --pane-id "$picker_id" "whxy-side-panel" 2>/dev/null || true
    focus_pane "$picker_id"
  fi
}

########################################## TERMINAL ##########################################

# Toggles a terminal pane at the bottom of the current WezTerm tab.
# If a terminal pane already exists it is closed.
# Otherwise a new terminal pane is opened at the bottom.
toggle_terminal() {
  [[ -n "${WEZTERM_PANE:-}" ]] || fail "terminal must be run inside WezTerm"

  local origin_pane="${WEZTERM_PANE}"

  # Find the terminal pane (title == "terminal") in this tab
  local terminal_pane_id
  terminal_pane_id="$(find_pane_by_title "terminal")"

  if [[ -n "$terminal_pane_id" ]]; then
    # Close the existing terminal pane
    kill_pane "$terminal_pane_id"
    focus_pane "$origin_pane"
    return
  fi

  # Create new terminal pane at the bottom (30% height)
  local terminal_id
  terminal_id="$(wezterm cli split-pane --bottom --percent 30 2>/dev/null | grep -o '[0-9]*' | head -n1)"

  if [[ -n "$terminal_id" ]]; then
    # Set the pane title to "terminal"
    wezterm cli set-tab-title --pane-id "$terminal_id" "terminal" 2>/dev/null || true
    focus_pane "$terminal_id"
  fi
}

########################################## BUFFER ##########################################

# Sends a command to a Helix instance running in the given pane.
# Presses Escape twice to ensure exit from edit/insert mode, then runs :<command><Enter>.
write_to_helix() {
  local pane_id="$1"
  shift
  local command_text="$*"

  focus_pane "$pane_id"
  # Send keys to the pane using wezterm cli send-text
  wezterm cli send-text --pane-id "$pane_id" --no-paste "$(printf '\033\033:%s\r' "$command_text")" 2>/dev/null || true
}

# Entry point for the picker pane process. Sets $EDITOR so that Yazi calls
# back into this script to open files in the origin Helix pane.
run_buffer() {
  local origin_pane="$1"
  local cwd="$2"

  export EDITOR="$script_path buffer edit $origin_pane"

  if [[ "${WHXY_USE_YAZI_CONFIG:-true}" != "false" ]]; then
    export YAZI_CONFIG_HOME="${whxy_home}"
  fi

  cd -- "$cwd"
  exec yazi "$cwd"
}

# Called by Yazi (via $EDITOR) when the user opens a selection.
# Sends a Helix :open or :cd command to the origin pane, then exits.
edit_from_picker() {
  local origin_pane="$1"
  shift
  local paths=("$@")
  local escaped_paths=()
  local path

  [[ ${#paths[@]} -gt 0 ]] || exit 0

  for path in "${paths[@]}"; do
    escaped_paths+=("$(printf '%q' "$path")")
  done

  if [[ ${#escaped_paths[@]} -eq 1 && ! -f "${paths[0]}" ]]; then
    write_to_helix "$origin_pane" "cd ${escaped_paths[0]}"
    exit 0
  fi

  write_to_helix "$origin_pane" "open ${escaped_paths[*]}"
}

########################################## VIBE ##########################################

# Opens the Copilot CLI in a WezTerm pane.
open_vibe() {
  [[ -n "${WEZTERM_PANE:-}" ]] || fail "vibe must be run inside WezTerm"

  local file="${1:-}"
  local line="${2:-}"

  # Create a new pane for Copilot CLI (75% width and height, centered)
  wezterm cli split-pane --right --percent 75 -- copilot 2>/dev/null || true
}

########################################## GIT ##########################################

# Opens LazyGit in a WezTerm pane.
open_lazygit() {
  [[ -n "${WEZTERM_PANE:-}" ]] || fail "git must be run inside WezTerm"

  # Create a new pane for LazyGit (90% width and height, centered)
  wezterm cli split-pane --right --percent 90 -- lazygit 2>/dev/null || true
}

########################################## MAIN ##########################################

# Parses top-level flags, dispatches to the appropriate sub-command, or
# bootstraps WezTerm with Helix when called with no arguments.
main() {
  local command="${1:-}"

  case "$command" in
    picker)
      shift
      toggle_picker "${1:-}"
      ;;
    terminal)
      toggle_terminal
      ;;
    git)
      shift
      open_lazygit
      ;;
    vibe)
      shift
      open_vibe "${1:-}" "${2:-}"
      ;;
    buffer)
      shift
      if [[ "${1:-}" == "edit" ]]; then
        shift
        [[ $# -ge 2 ]] || fail "buffer edit requires <origin-pane> <path>..."
        edit_from_picker "$@"
      else
        [[ $# -eq 2 ]] || fail "buffer requires <origin-pane> <cwd>"
        run_buffer "$1" "$2"
      fi
      ;;
    -h|--help|help)
      usage
      ;;
    "")
      # Try 'hx' first, then fall back to 'helix'
      local hx_cmd=""
      if command -v hx &> /dev/null; then
        hx_cmd="hx"
      elif command -v helix &> /dev/null; then
        hx_cmd="helix"
      else
        fail "helix not found. Please install helix or hx"
      fi

      # Start WezTerm with Helix if not already in WezTerm
      if [[ -z "${WEZTERM_PANE:-}" ]]; then
        export MULTIPLEXER=wezterm
        exec wezterm start -- "$hx_cmd"
      else
        # If already in WezTerm, just start Helix
        export MULTIPLEXER=wezterm
        exec "$hx_cmd"
      fi
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
